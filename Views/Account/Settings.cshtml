@using LeadScoutCRM.Models.Entities
@{
    ViewData["Title"] = "A Minha Conta";

    var user = ViewBag.User as ApplicationUser;
    var plan = ViewBag.Plan as PlanInfo;
    var leadCount = (int)ViewBag.LeadCount;

    // Calcula % de utilização para o plano Free
    var isLimited = plan!.LeadLimit != int.MaxValue;
    var usagePct = isLimited ? (int)Math.Min(100, (double)leadCount / plan.LeadLimit * 100) : 0;
    var usageBar = usagePct >= 90 ? "bg-danger" : usagePct >= 70 ? "bg-warning" : "bg-success";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">A Minha Conta</h4>
        <span class="text-muted" style="font-size:.875rem">Gerir subscrição e dados de conta</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4 rounded-3" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 rounded-3" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}
<div class="row g-4">

    <!-- ── Coluna esquerda: Perfil + Plano Actual ── -->
    <div class="col-lg-5">

        <!-- Perfil -->
        <div class="card table-card p-4 mb-4">
            <h6 class="fw-semibold mb-3">
                <i class="bi bi-person-circle me-1"></i>Perfil
            </h6>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:52px;height:52px;border-radius:50%;background:#ede9fe;
                            display:flex;align-items:center;justify-content:center;
                            font-weight:700;font-size:1.1rem;color:#6366f1;">
                    @(user?.DisplayName?.Substring(0, 1).ToUpper() ?? "?")
                </div>
                <div>
                    <div class="fw-semibold">@user?.DisplayName</div>
                    <div class="text-muted small">@user?.Email</div>
                </div>
            </div>
            <dl class="row mb-0 small">
                <dt class="col-5 text-muted">Membro desde</dt>
                <dd class="col-7">@user?.CreatedAt.ToString("dd/MM/yyyy")</dd>
                <dt class="col-5 text-muted">Estado</dt>
                <dd class="col-7">
                    @if (user?.SubscriptionStatus == SubscriptionStatus.Active)
                    {
                        <span class="badge" style="background:#dcfce7;color:#15803d">
                            <i class="bi bi-check-circle-fill me-1"></i>Activo
                        </span>
                    }
                    else if (user?.SubscriptionStatus == SubscriptionStatus.PastDue)
                    {
                        <span class="badge" style="background:#fef9c3;color:#a16207">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Pagamento pendente
                        </span>
                    }
                    else
                    {
                        <span class="badge" style="background:#f1f5f9;color:#64748b">
                            <i class="bi bi-circle me-1"></i>Free
                        </span>
                    }
                </dd>
            </dl>
        </div>

        <!-- Plano Actual -->
        <div class="card table-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h6 class="fw-semibold mb-0">
                    <i class="bi bi-lightning-fill me-1" style="color:#6366f1"></i>Plano Actual
                </h6>
                <span class="badge rounded-pill px-3 py-1 fw-semibold"
                      style="background:@(user?.Plan == SubscriptionPlan.Business ? "#dcfce7" : user?.Plan == SubscriptionPlan.Pro ? "#ede9fe" : "#f1f5f9");
                             color:@(user?.Plan == SubscriptionPlan.Business ? "#15803d" : user?.Plan == SubscriptionPlan.Pro ? "#6366f1" : "#64748b")">
                    @plan?.Name
                </span>
            </div>

            <!-- Barra de utilização (só para Free) -->
            @if (isLimited)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Leads utilizadas</small>
                        <small class="fw-semibold @(usagePct >= 90 ? "text-danger" : "")">
                            @leadCount / @plan!.LeadLimit
                        </small>
                    </div>
                    <div class="progress" style="height:6px;border-radius:4px">
                        <div class="progress-bar @usageBar" style="width:@usagePct%"></div>
                    </div>
                    @if (usagePct >= 90)
                    {
                        <small class="text-danger mt-1 d-block">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Estás quase no limite! Faz upgrade para continuares.
                        </small>
                    }
                </div>
            }
            else
            {
                <div class="mb-3">
                    <small class="text-muted">Leads criadas</small>
                    <div class="fw-bold fs-5">@leadCount</div>
                    <small class="text-success"><i class="bi bi-infinity me-1"></i>Ilimitadas</small>
                </div>
            }

            <!-- Features do plano -->
            <ul class="list-unstyled mb-3 small">
                <li class="mb-1">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    @(plan!.LeadLimit == int.MaxValue ? "Leads ilimitadas" : $"Até {plan.LeadLimit} leads")
                </li>
                <li class="mb-1">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    Pipeline Kanban
                </li>
                <li class="mb-1">
                    <i class="bi @(plan.HasExport ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-2"></i>
                    Exportar para CSV
                </li>
                <li class="mb-1">
                    <i class="bi @(plan.HasApiAccess ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-2"></i>
                    Acesso API
                </li>
            </ul>

            <!-- Botões de acção -->
            @if (user?.Plan == SubscriptionPlan.Free)
            {
                <a href="/Pricing" class="btn btn-accent w-100 mb-2">
                    <i class="bi bi-arrow-up-circle me-1"></i>Fazer Upgrade
                </a>
            }
            else
            {
                <form asp-controller="Account" asp-action="ManageSubscription" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-credit-card me-1"></i>Gerir Subscrição Stripe
                    </button>
                </form>
            }

            @if (user?.SubscriptionEndsAt.HasValue == true)
            {
                <small class="text-muted d-block text-center">
                    Subscrição termina em @user.SubscriptionEndsAt.Value.ToString("dd/MM/yyyy")
                </small>
            }
        </div>

    </div>

    <!-- ── Coluna direita: Comparação de Planos ── -->
    <div class="col-lg-7">
        <div class="card table-card p-4">
            <h6 class="fw-semibold mb-3">
                <i class="bi bi-rocket-takeoff me-1"></i>Comparar Planos
            </h6>

            <div class="row g-3">

                <!-- Free -->
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100 @(user?.Plan == SubscriptionPlan.Free ? "border border-2" : "")"
                         style="background:#f8fafc;@(user?.Plan == SubscriptionPlan.Free ? "border-color:#6366f1 !important" : "")">
                        @if (user?.Plan == SubscriptionPlan.Free)
                        {
                            <div class="badge mb-2" style="background:#ede9fe;color:#6366f1">Plano actual</div>
                        }
                        <div class="fw-bold mb-1">Free</div>
                        <div class="mb-2">
                            <span class="fs-4 fw-bold">0€</span>
                            <span class="text-muted small">/mês</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>10 leads</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Kanban</li>
                            <li class="mb-1"><i class="bi bi-x me-1 text-muted"></i>Export CSV</li>
                            <li class="mb-1"><i class="bi bi-x me-1 text-muted"></i>API</li>
                        </ul>
                        <div class="text-center small text-muted">Plano actual</div>
                    </div>
                </div>

                <!-- Pro -->
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100 @(user?.Plan == SubscriptionPlan.Pro ? "border border-2" : "border")"
                         style="background:@(user?.Plan == SubscriptionPlan.Pro ? "#fff" : "#fff");
                                border-color:@(user?.Plan == SubscriptionPlan.Pro ? "#6366f1" : "#e2e8f0") !important">
                        @if (user?.Plan == SubscriptionPlan.Pro)
                        {
                            <div class="badge mb-2" style="background:#ede9fe;color:#6366f1">Plano actual</div>
                        }
                        else
                        {
                            <div class="badge mb-2" style="background:#ede9fe;color:#6366f1">Mais popular</div>
                        }
                        <div class="fw-bold mb-1">Pro</div>
                        <div class="mb-2">
                            <span class="fs-4 fw-bold">19€</span>
                            <span class="text-muted small">/mês</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Leads ilimitadas</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Kanban</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Export CSV</li>
                            <li class="mb-1"><i class="bi bi-x me-1 text-muted"></i>API</li>
                        </ul>
                        @if (user?.Plan != SubscriptionPlan.Pro && user?.Plan != SubscriptionPlan.Business)
                        {
                            <form asp-controller="Account" asp-action="Upgrade" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="plan" value="Pro" />
                                <button type="submit" class="btn btn-accent w-100 btn-sm">
                                    Upgrade para Pro
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- Business -->
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100 @(user?.Plan == SubscriptionPlan.Business ? "border border-2" : "border")"
                         style="background:#fff;
                                border-color:@(user?.Plan == SubscriptionPlan.Business ? "#6366f1" : "#e2e8f0") !important">
                        @if (user?.Plan == SubscriptionPlan.Business)
                        {
                            <div class="badge mb-2" style="background:#dcfce7;color:#15803d">Plano actual</div>
                        }
                        else
                        {
                            <div class="badge mb-2" style="background:#f0fdf4;color:#15803d">Business</div>
                        }
                        <div class="fw-bold mb-1">Business</div>
                        <div class="mb-2">
                            <span class="fs-4 fw-bold">49€</span>
                            <span class="text-muted small">/mês</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Leads ilimitadas</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Kanban</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Export CSV</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>API access</li>
                        </ul>
                        @if (user?.Plan != SubscriptionPlan.Business)
                        {
                            <form asp-controller="Account" asp-action="Upgrade" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="plan" value="Business" />
                                <button type="submit" class="btn btn-outline-success w-100 btn-sm">
                                    Upgrade para Business
                                </button>
                            </form>
                        }
                    </div>
                </div>

            </div>
        </div>

        <!-- Zona de perigo -->
        <div class="card table-card p-4 mt-4" style="border-left:4px solid #fee2e2">
            <h6 class="fw-semibold text-danger mb-2">
                <i class="bi bi-exclamation-triangle me-1"></i>Zona de Perigo
            </h6>
            <p class="text-muted small mb-3">
                O logout termina a tua sessão em todos os dispositivos.
            </p>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Terminar sessão
                </button>
            </form>
        </div>

    </div>
</div>
