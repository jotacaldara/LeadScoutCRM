@using LeadScoutCRM.Models.Entities
@{
    ViewData["Title"] = "A Minha Conta";

    var user = ViewBag.User as ApplicationUser;
    var plan = ViewBag.Plan as PlanInfo;
    var leadCount = (int)ViewBag.LeadCount;

    // Calcula % de utilização para o plano Free
    var isLimited = plan!.LeadLimit != int.MaxValue;
    var usagePct = isLimited ? (int)Math.Min(100, (double)leadCount / plan.LeadLimit * 100) : 0;
    var usageBar = usagePct >= 90 ? "bg-danger" : usagePct >= 70 ? "bg-warning" : "bg-success";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">A Minha Conta</h4>
        <span class="text-muted" style="font-size:.875rem">Gerir subscrição e dados de conta</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4 rounded-3" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 rounded-3" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}
<div class="row g-4">

    <!-- ── Coluna esquerda: Perfil + Plano Actual ── -->
    <div class="col-lg-5">

        <!-- Perfil -->
        <div class="card table-card p-4 mb-4">
            <h6 class="fw-semibold mb-3">
                <i class="bi bi-person-circle me-1"></i>Perfil
            </h6>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:52px;height:52px;border-radius:50%;background:#ede9fe;
                    display:flex;align-items:center;justify-content:center;
                    font-weight:700;font-size:1.1rem;color:#6366f1;">
                    @(user?.DisplayName?.Substring(0, 1).ToUpper() ?? "?")
                </div>
                <div>
                    <div class="fw-semibold">@user?.DisplayName</div>
                    <div class="text-muted small">@user?.Email</div>
                </div>
            </div>
            <dl class="row mb-0 small">
                <dt class="col-5 text-muted">Membro desde</dt>
                <dd class="col-7">@user?.CreatedAt.ToString("dd/MM/yyyy")</dd>
                <dt class="col-5 text-muted">Estado</dt>
                <dd class="col-7">
                    @if (user?.SubscriptionStatus == SubscriptionStatus.Active)
                    {
                        <span class="badge" style="background:#dcfce7;color:#15803d">
                            <i class="bi bi-check-circle-fill me-1"></i>Activo
                        </span>
                    }
                    else if (user?.SubscriptionStatus == SubscriptionStatus.PastDue)
                    {
                        <span class="badge" style="background:#fef9c3;color:#a16207">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Pagamento pendente
                        </span>
                    }
                    else
                    {
                        <span class="badge" style="background:#f1f5f9;color:#64748b">
                            <i class="bi bi-circle me-1"></i>Free
                        </span>
                    }
                </dd>
            </dl>
        </div>

        <!-- Plano Actual -->
        <div class="card table-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h6 class="fw-semibold mb-0">
                    <i class="bi bi-lightning-fill me-1" style="color:#6366f1"></i>Plano Actual
                </h6>
                <span class="badge rounded-pill px-3 py-1 fw-semibold"
                      style="background:@(user?.Plan == SubscriptionPlan.Business ? "#dcfce7" : user?.Plan == SubscriptionPlan.Pro ? "#ede9fe" : "#f1f5f9");
                    color:@(user?.Plan == SubscriptionPlan.Business ? "#15803d" : user?.Plan == SubscriptionPlan.Pro ? "#6366f1" : "#64748b")">
                    @plan?.Name
                </span>
            </div>

            <!-- Barra de utilização (só para Free) -->
            @if (isLimited)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Leads utilizadas</small>
                        <small class="fw-semibold @(usagePct >= 90 ? "text-danger" : "")">
                            @leadCount / @plan!.LeadLimit
                        </small>
                    </div>
                    <div class="progress" style="height:6px;border-radius:4px">
                        <div class="progress-bar @usageBar" style="width:@usagePct%"></div>
                    </div>
                    @if (usagePct >= 90)
                    {
                        <small class="text-danger mt-1 d-block">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Estás quase no limite! Faz upgrade para continuares.
                        </small>
                    }
                </div>
            }
            else
            {
                <div class="mb-3">
                    <small class="text-muted">Leads criadas</small>
                    <div class="fw-bold fs-5">@leadCount</div>
                    <small class="text-success"><i class="bi bi-infinity me-1"></i>Ilimitadas</small>
                </div>
            }

            <!-- Features do plano -->
            <ul class="list-unstyled mb-3 small">
                <li class="mb-1">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    @(plan!.LeadLimit == int.MaxValue ? "Leads ilimitadas" : $"Até {plan.LeadLimit} leads")
                </li>
                <li class="mb-1">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    Pipeline Kanban
                </li>
                <li class="mb-1">
                    <i class="bi @(plan.HasExport ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-2"></i>
                    Exportar para CSV
                </li>
                <li class="mb-1">
                    <i class="bi @(plan.HasApiAccess ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-2"></i>
                    Acesso API
                </li>
            </ul>

            <!-- Botões de acção -->
            @if (user?.Plan == SubscriptionPlan.Free)
            {
                <a href="/Pricing" class="btn btn-accent w-100 mb-2">
                    <i class="bi bi-arrow-up-circle me-1"></i>Fazer Upgrade
                </a>
            }
            else
            {
                <form asp-controller="Account" asp-action="ManageSubscription" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-credit-card me-1"></i>Gerir Subscrição Stripe
                    </button>
                </form>
            }

            @if (user?.SubscriptionEndsAt.HasValue == true)
            {
                <small class="text-muted d-block text-center">
                    Subscrição termina em @user.SubscriptionEndsAt.Value.ToString("dd/MM/yyyy")
                </small>
            }
        </div>

        @if (user?.Plan == SubscriptionPlan.Business)
        {
            <div class="card table-card p-4 mt-4">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-key-fill me-1" style="color:#6366f1"></i>Acesso API
                    <span class="badge bg-light text-dark ms-1" style="font-size:.65rem">Business</span>
                </h6>

                @if (TempData["NewApiKey"] != null)
                {
                    <div class="alert alert-warning rounded-3 mb-3">
                        <div class="fw-semibold small mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Copia a tua chave agora — não voltará a ser mostrada.
                        </div>
                        <div class="input-group">
                            <input type="text" id="newApiKey" class="form-control font-monospace small"
                                   value="@TempData["NewApiKey"]" readonly />
                            <button class="btn btn-outline-secondary" type="button" onclick="copyApiKey()">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(user.ApiKeyHash))
                {
                    <dl class="row small mb-3">
                        <dt class="col-5 text-muted">Estado</dt>
                        <dd class="col-7">
                            <span class="badge" style="background:#dcfce7;color:#15803d">
                                <i class="bi bi-check-circle-fill me-1"></i>Ativa
                            </span>
                        </dd>
                        <dt class="col-5 text-muted">Gerada em</dt>
                        <dd class="col-7">@user.ApiKeyCreatedAt?.ToString("dd/MM/yyyy HH:mm")</dd>
                        <dt class="col-5 text-muted">Último uso</dt>
                        <dd class="col-7">
                            @(user.ApiKeyLastUsedAt.HasValue
                                ? user.ApiKeyLastUsedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                : "Nunca utilizada")
                        </dd>
                    </dl>
                    <p class="text-muted small">
                        Usa o cabeçalho <code>X-Api-Key</code> nos pedidos a
                        <code>/api/v1/leads</code>. Documentação em
                        <a href="/swagger" target="_blank">/swagger</a>.
                    </p>
                    <div class="d-flex gap-2">
                        <form asp-controller="Account" asp-action="GenerateApiKey" method="post" class="m-0"
                              onsubmit="return confirm('Gerar uma nova chave invalida a anterior. Continuar?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-arrow-repeat me-1"></i>Gerar Nova
                            </button>
                        </form>
                        <form asp-controller="Account" asp-action="RevokeApiKey" method="post" class="m-0"
                              onsubmit="return confirm('Tens a certeza que queres revogar a chave API?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i>Revogar
                            </button>
                        </form>
                    </div>

                    <hr style="border-color:#e2e8f0;margin:1.25rem 0">

                    <h6 class="fw-semibold mb-3" style="font-size:.85rem">
                        <i class="bi bi-lightning-charge me-1" style="color:#6366f1"></i>Testar a API
                    </h6>
                    <p class="text-muted small mb-3">
                        Cola a tua chave e experimenta um pedido real — exatamente como uma
                        integração externa (Zapier, script próprio, etc.) faria.
                    </p>

                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Chave API</label>
                        <input type="text" id="apiTesterKey" class="form-control form-control-sm font-monospace"
                               placeholder="Cola aqui a tua chave (lsk_...)" />
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Endpoint</label>
                            <select id="apiTesterEndpoint" class="form-select form-select-sm" onchange="updateApiTesterFields()">
                                <option value="list">GET /api/v1/leads — Listar leads</option>
                                <option value="get">GET /api/v1/leads/{id} — Obter uma lead</option>
                                <option value="status">PATCH /api/v1/leads/{id}/status — Atualizar status</option>
                            </select>
                        </div>
                        <div class="col-md-3" id="apiTesterLeadIdGroup" style="display:none">
                            <label class="form-label small text-muted mb-1">ID da Lead</label>
                            <input type="number" id="apiTesterLeadId" class="form-control form-control-sm" placeholder="ex: 12" />
                        </div>
                        <div class="col-md-3" id="apiTesterStatusGroup" style="display:none">
                            <label class="form-label small text-muted mb-1">Novo Status</label>
                            <select id="apiTesterStatus" class="form-select form-select-sm">
                                <option value="Novo">Novo</option>
                                <option value="MensagemEnviada">Mensagem Enviada</option>
                                <option value="EmNegociacao">Em Negociação</option>
                                <option value="ClienteFechado">Cliente Fechado</option>
                                <option value="Rejeitado">Rejeitado</option>
                            </select>
                        </div>
                    </div>

                    <button type="button" id="apiTesterRunBtn" class="btn btn-sm btn-accent mb-3" onclick="runApiTest()">
                        <i class="bi bi-play-fill me-1"></i>Executar Pedido
                    </button>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="text-muted small">Resposta:</span>
                        <span id="apiTesterStatusBadge" class="badge bg-secondary">—</span>
                    </div>
                    <pre id="apiTesterResult"
                         class="border rounded p-3 mb-0 small"
                         style="background:#0f172a;color:#a5f3c8;max-height:280px;overflow:auto;white-space:pre-wrap;word-break:break-word;font-family:'IBM Plex Mono',monospace">Os resultados do pedido aparecem aqui.</pre>
                }
                else
                {
                    <p class="text-muted small">
                        Gera uma chave API para integrares o LeadScout CRM com outras
                        ferramentas (Zapier, scripts próprios, etc.).
                    </p>
                    <form asp-controller="Account" asp-action="GenerateApiKey" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-accent btn-sm">
                            <i class="bi bi-key me-1"></i>Gerar Chave API
                        </button>
                    </form>
                }
            </div>
        }

    </div>

    <!-- ── Coluna direita: Comparação de Planos ── -->
    <div class="col-lg-7">
        <div class="card table-card p-4">
            <h6 class="fw-semibold mb-3">
                <i class="bi bi-rocket-takeoff me-1"></i>Comparar Planos
            </h6>

            <div class="row g-3">

                <!-- Free -->
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100 @(user?.Plan == SubscriptionPlan.Free ? "border border-2" : "")"
                         style="background:#f8fafc;@(user?.Plan == SubscriptionPlan.Free ? "border-color:#6366f1 !important" : "")">
                        @if (user?.Plan == SubscriptionPlan.Free)
                        {
                            <div class="badge mb-2" style="background:#ede9fe;color:#6366f1">Plano actual</div>
                        }
                        <div class="fw-bold mb-1">Free</div>
                        <div class="mb-2">
                            <span class="fs-4 fw-bold">0€</span>
                            <span class="text-muted small">/mês</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>10 leads</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Kanban</li>
                            <li class="mb-1"><i class="bi bi-x me-1 text-muted"></i>Export CSV</li>
                            <li class="mb-1"><i class="bi bi-x me-1 text-muted"></i>API</li>
                        </ul>
                        <div class="text-center small text-muted">Plano actual</div>
                    </div>
                </div>

                <!-- Pro -->
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100 @(user?.Plan == SubscriptionPlan.Pro ? "border border-2" : "border")"
                         style="background:@(user?.Plan == SubscriptionPlan.Pro ? "#fff" : "#fff");
                        border-color:@(user?.Plan == SubscriptionPlan.Pro ? "#6366f1" : "#e2e8f0") !important">
                        @if (user?.Plan == SubscriptionPlan.Pro)
                        {
                            <div class="badge mb-2" style="background:#ede9fe;color:#6366f1">Plano actual</div>
                        }
                        else
                        {
                            <div class="badge mb-2" style="background:#ede9fe;color:#6366f1">Mais popular</div>
                        }
                        <div class="fw-bold mb-1">Pro</div>
                        <div class="mb-2">
                            <span class="fs-4 fw-bold">19€</span>
                            <span class="text-muted small">/mês</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Leads ilimitadas</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Kanban</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Export CSV</li>
                            <li class="mb-1"><i class="bi bi-x me-1 text-muted"></i>API</li>
                        </ul>
                        @if (user?.Plan != SubscriptionPlan.Pro && user?.Plan != SubscriptionPlan.Business)
                        {
                            <form asp-controller="Account" asp-action="Upgrade" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="plan" value="Pro" />
                                <button type="submit" class="btn btn-accent w-100 btn-sm">
                                    Upgrade para Pro
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- Business -->
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100 @(user?.Plan == SubscriptionPlan.Business ? "border border-2" : "border")"
                         style="background:#fff;
                        border-color:@(user?.Plan == SubscriptionPlan.Business ? "#6366f1" : "#e2e8f0") !important">
                        @if (user?.Plan == SubscriptionPlan.Business)
                        {
                            <div class="badge mb-2" style="background:#dcfce7;color:#15803d">Plano actual</div>
                        }
                        else
                        {
                            <div class="badge mb-2" style="background:#f0fdf4;color:#15803d">Business</div>
                        }
                        <div class="fw-bold mb-1">Business</div>
                        <div class="mb-2">
                            <span class="fs-4 fw-bold">49€</span>
                            <span class="text-muted small">/mês</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Leads ilimitadas</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Kanban</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>Export CSV</li>
                            <li class="mb-1"><i class="bi bi-check me-1 text-success"></i>API access</li>
                        </ul>
                        @if (user?.Plan != SubscriptionPlan.Business)
                        {
                            <form asp-controller="Account" asp-action="Upgrade" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="plan" value="Business" />
                                <button type="submit" class="btn btn-outline-success w-100 btn-sm">
                                    Upgrade para Business
                                </button>
                            </form>
                        }
                    </div>
                </div>

            </div>
        </div>

        <!-- Zona de perigo -->
        <div class="card table-card p-4 mt-4" style="border-left:4px solid #fee2e2">
            <h6 class="fw-semibold text-danger mb-2">
                <i class="bi bi-exclamation-triangle me-1"></i>Zona de Perigo
            </h6>
            <p class="text-muted small mb-3">
                O logout termina a tua sessão em todos os dispositivos.
            </p>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Terminar sessão
                </button>
            </form>
        </div>

    </div>
</div>

@if (user?.Plan == SubscriptionPlan.Business)
{
    var webhooks = ViewBag.Webhooks as List<WebhookSubscription> ?? new();
    var deliveries = ViewBag.RecentDeliveries as List<WebhookDeliveryLog> ?? new();

    <div class="row g-4 mt-4">
        <div class="col-12">
            <div class="card table-card p-4">
                <h6 class="fw-semibold mb-1">
                    <i class="bi bi-broadcast me-1" style="color:#6366f1"></i>Webhooks de Saída
                    <span class="badge bg-light text-dark ms-1" style="font-size:.65rem">Business</span>
                </h6>
                <p class="text-muted small mb-4">
                    Regista um URL para receberes um pedido HTTP automático sempre que uma lead
                    é criada ou muda de status — sem teres de perguntar à API periodicamente.
                    Compatível com o módulo "Webhooks" do Zapier e do Make.
                </p>

                @if (TempData["NewWebhookSecret"] != null)
                {
                    <div class="alert alert-warning rounded-3 mb-4">
                        <div class="fw-semibold small mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Guarda este segredo — não voltará a ser mostrado. É usado para
                            verificares a assinatura de cada pedido recebido.
                        </div>
                        <div class="input-group">
                            <input type="text" id="newWebhookSecret" class="form-control font-monospace small"
                                   value="@TempData["NewWebhookSecret"]" readonly />
                            <button class="btn btn-outline-secondary" type="button" onclick="copyWebhookSecret()">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                }

                <div class="row g-4">
                    <div class="col-lg-6">
                        @if (webhooks.Any())
                        {
                            <div class="d-flex flex-column gap-2 mb-4">
                                @foreach (var wh in webhooks)
                                {
                                    <div class="border rounded-3 p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <div class="text-truncate fw-medium small" style="max-width:260px" title="@wh.TargetUrl">
                                                @wh.TargetUrl
                                            </div>
                                            <span class="badge bg-light text-dark">@wh.EventType</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(wh.Description))
                                        {
                                            <div class="text-muted small mb-2">@wh.Description</div>
                                        }
                                        <div class="text-muted small mb-2">
                                            Criado em @wh.CreatedAt.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="d-flex gap-2">
                                            <form asp-action="TestWebhook" asp-route-id="@wh.Id" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-send me-1"></i>Testar
                                                </button>
                                            </form>
                                            <form asp-action="DeleteWebhook" asp-route-id="@wh.Id" method="post" class="m-0"
                                                  onsubmit="return confirm('Remover este webhook?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-4">Ainda não tens nenhum webhook registado.</p>
                        }

                        <details>
                            <summary class="small fw-medium mb-2" style="cursor:pointer;color:#6366f1">
                                <i class="bi bi-plus-circle me-1"></i>Registar novo webhook
                            </summary>
                            <form asp-action="CreateWebhook" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label class="form-label small text-muted mb-1">URL de destino (https)</label>
                                    <input type="url" name="targetUrl" class="form-control form-control-sm"
                                           placeholder="https://hooks.zapier.com/..." required pattern="https://.*" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-muted mb-1">Evento</label>
                                    <select name="eventType" class="form-select form-select-sm">
                                        <option value="All">Todos os eventos</option>
                                        <option value="LeadCreated">Lead criada</option>
                                        <option value="LeadStatusChanged">Status alterado</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1">Descrição (opcional)</label>
                                    <input type="text" name="description" class="form-control form-control-sm"
                                           placeholder="ex: Zap de sincronização com Sheets" maxlength="100" />
                                </div>
                                <button type="submit" class="btn btn-accent btn-sm">
                                    <i class="bi bi-plus-lg me-1"></i>Registar Webhook
                                </button>
                            </form>
                        </details>
                    </div>

                    <div class="col-lg-6">
                        <h6 class="fw-semibold mb-2" style="font-size:.85rem">Entregas Recentes</h6>
                        @if (deliveries.Any())
                        {
                            <div class="table-responsive" style="max-height:360px;overflow-y:auto">
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr><th>Evento</th><th>Estado</th><th>Quando</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in deliveries)
                                        {
                                            <tr>
                                                <td class="small">@log.EventType</td>
                                                <td>
                                                    @if (log.Success)
                                                    {
                                                        <span class="badge" style="background:#dcfce7;color:#15803d">
                                                            @(log.ResponseStatusCode?.ToString() ?? "OK")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge" style="background:#fee2e2;color:#b91c1c"
                                                              title="@(log.ErrorMessage ?? "")">
                                                            @(log.ResponseStatusCode?.ToString() ?? "Falhou")
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@log.SentAt.ToString("dd/MM HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">Ainda não há entregas registadas.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function copyApiKey() {
            const input = document.getElementById('newApiKey');
            input.select();
            navigator.clipboard.writeText(input.value).then(() => showToast('Chave copiada!', 'success'));
        }
        function copyWebhookSecret() {
            const input = document.getElementById('newWebhookSecret');
            input.select();
            navigator.clipboard.writeText(input.value).then(() => showToast('Segredo copiado!', 'success'));
        }

        function updateApiTesterFields() {
            const endpoint = document.getElementById('apiTesterEndpoint').value;
            document.getElementById('apiTesterLeadIdGroup').style.display =
                (endpoint === 'get' || endpoint === 'status') ? 'block' : 'none';
            document.getElementById('apiTesterStatusGroup').style.display =
                (endpoint === 'status') ? 'block' : 'none';
        }

        async function runApiTest() {
            const btn = document.getElementById('apiTesterRunBtn');
            const key = document.getElementById('apiTesterKey').value.trim();
            const endpoint = document.getElementById('apiTesterEndpoint').value;
            const leadIdField = document.getElementById('apiTesterLeadId');
            const statusField = document.getElementById('apiTesterStatus');
            const resultBox = document.getElementById('apiTesterResult');
            const statusBadge = document.getElementById('apiTesterStatusBadge');

            if (!key) {
                showToast('Cola a tua chave API primeiro.', 'info');
                return;
            }

            let url = '';
            let method = 'GET';
            let body = null;

            if (endpoint === 'list') {
                url = '/api/v1/leads?page=1&pageSize=5';
            } else if (endpoint === 'get') {
                if (!leadIdField.value) { showToast('Indica o ID da lead.', 'info'); return; }
                url = `/api/v1/leads/${leadIdField.value}`;
            } else if (endpoint === 'status') {
                if (!leadIdField.value) { showToast('Indica o ID da lead.', 'info'); return; }
                url = `/api/v1/leads/${leadIdField.value}/status`;
                method = 'PATCH';
                body = JSON.stringify({ status: statusField.value });
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>A executar...';
            statusBadge.className = 'badge bg-secondary';
            statusBadge.textContent = '...';
            resultBox.textContent = 'A aguardar resposta...';

            try {
                const res = await fetch(url, {
                    method,
                    headers: {
                        'X-Api-Key': key,
                        ...(body ? { 'Content-Type': 'application/json' } : {})
                    },
                    body
                });

                const raw = await res.text();
                let pretty;
                try { pretty = JSON.stringify(JSON.parse(raw), null, 2); }
                catch { pretty = raw || '(sem conteúdo)'; }

                statusBadge.textContent = `${res.status} ${res.statusText}`;
                statusBadge.className = 'badge ' + (res.ok ? 'bg-success' : 'bg-danger');
                resultBox.textContent = pretty;
            } catch (err) {
                statusBadge.textContent = 'Erro de rede';
                statusBadge.className = 'badge bg-danger';
                resultBox.textContent = String(err);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-play-fill me-1"></i>Executar Pedido';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const newKeyField = document.getElementById('newApiKey');
            const testerKeyField = document.getElementById('apiTesterKey');
            if (newKeyField && testerKeyField) {
                testerKeyField.value = newKeyField.value;
            }
        });
    </script>
}