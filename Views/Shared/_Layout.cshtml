<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — LeadScout CRM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 240px;
            --accent: #6366f1;
            --accent-hover: #4f46e5;
        }

        body {
            background: #f1f5f9;
            font-family: 'Segoe UI', sans-serif;
        }

        /* ── Sidebar ── */
        #sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: #1e293b;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
        }

            #sidebar .brand {
                padding: 1.5rem 1.25rem;
                border-bottom: 1px solid #334155;
                flex-shrink: 0;
            }

                #sidebar .brand span {
                    color: #6366f1;
                    font-weight: 700;
                    font-size: 1.2rem;
                }

            #sidebar .nav-link {
                color: #94a3b8;
                padding: .65rem 1.25rem;
                border-radius: 8px;
                margin: 2px 8px;
                transition: all .15s;
                font-size: .9rem;
            }

                #sidebar .nav-link:hover,
                #sidebar .nav-link.active {
                    background: #334155;
                    color: #fff;
                }

                #sidebar .nav-link i {
                    margin-right: 8px;
                    width: 18px;
                    text-align: center;
                }

            #sidebar .nav-section {
                flex: 1;
                overflow-y: auto;
                padding-top: .5rem;
            }

            #sidebar .sidebar-footer {
                padding: 1rem;
                border-top: 1px solid #334155;
                flex-shrink: 0;
            }

            #sidebar .version-badge {
                background: #334155;
                border-radius: 8px;
                padding: .75rem 1rem;
            }

        /* ── Main content ── */
        #main {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            min-height: 100vh;
        }

        /* ── Cards ── */
        .stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

            .stat-card .icon-box {
                width: 48px;
                height: 48px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
            }

        .table-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
            overflow: hidden;
        }

        /* ── Tabela ── */
        .table thead th {
            background: #f8fafc;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #64748b;
            border-bottom: 1px solid #e2e8f0;
        }

        .table tbody tr:hover {
            background: #f8fafc;
        }

        /* ── Badges de Status ── */
        .badge-novo {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .badge-mensagemenviada {
            background: #fef9c3;
            color: #a16207;
        }

        .badge-emnegociacao {
            background: #ffedd5;
            color: #c2410c;
        }

        .badge-clientefechado {
            background: #dcfce7;
            color: #15803d;
        }

        .badge-rejeitado {
            background: #fee2e2;
            color: #b91c1c;
        }

        /* ── Botão accent ── */
        .btn-accent {
            background: var(--accent);
            color: #fff;
            border: none;
        }

            .btn-accent:hover {
                background: var(--accent-hover);
                color: #fff;
            }

        /* ── Toast ── */
        #toastContainer {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
        }
    </style>
</head>
<body>

    <!-- ── Sidebar ── -->
    <nav id="sidebar">
        <div class="brand d-flex align-items-center gap-2">
            <i class="bi bi-crosshair2" style="color:#6366f1;font-size:1.4rem"></i>
            <span>LeadScout CRM</span>
        </div>

        <div class="nav-section">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       href="/">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" && ViewContext.RouteData.Values["action"]?.ToString() == "Search" ? "active" : "")"
                       href="/Leads/Search">
                        <i class="bi bi-search"></i> Nova Pesquisa
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       href="/Leads">
                        <i class="bi bi-people"></i> Todas as Leads
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" && ViewContext.RouteData.Values["action"]?.ToString() == "Kanban" ? "active" : "")"
                       href="/Leads/Kanban">
                        <i class="bi bi-kanban"></i> Pipeline Kanban
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analytics" ? "active" : "")"
                       href="/Analytics">
                        <i class="bi bi-bar-chart-line"></i> Analytics
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pricing" ? "active" : "")"
                       href="/Pricing">
                        <i class="bi bi-lightning-charge"></i> Planos
                    </a>
                </li>
            </ul>

            <hr style="border-color:#334155;margin:.75rem 8px">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")"
                           href="/Account/Settings">
                            <i class="bi bi-person-circle"></i> A minha conta
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                               href="/Admin">
                                <i class="bi bi-shield-lock"></i> Área Admin
                            </a>
                        </li>
                    }

                    <li class="nav-item mt-1">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="nav-link text-start w-100 border-0 bg-transparent"
                                    style="color:#f87171;">
                                <i class="bi bi-box-arrow-right"></i> Terminar Sessão
                            </button>
                        </form>
                    </li>
                </ul>
            }
            else
            {
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : "")"
                           href="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Entrar
                        </a>
                    </li>
                    <li class="nav-item mt-1 px-2">
                        <a class="btn btn-accent btn-sm w-100 py-2" href="/Account/Register"
                           style="border-radius:8px;">
                            <i class="bi bi-rocket me-1"></i> Criar Conta
                        </a>
                    </li>
                </ul>
            }
        </div>

        <!-- Versão (só uma vez, no fundo) -->
        <div class="sidebar-footer">
            <div class="version-badge">
                <div style="color:#94a3b8;font-size:.72rem;">Versão Beta</div>
                <div style="color:#e2e8f0;font-size:.8rem;font-weight:600;">LeadScout CRM v1.0</div>
            </div>
        </div>
    </nav>

    <!-- ── Conteúdo Principal ── -->
    <div id="main">
        @RenderBody()
    </div>

    <!-- Toast container -->
    <div id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function showToast(message, type = 'success') {
            const colors = {
                success: '#15803d',
                error:   '#b91c1c',
                info:    '#1d4ed8'
            };
            const toast = document.createElement('div');
            toast.style.cssText = `
                background:${colors[type]};color:#fff;
                padding:.75rem 1.25rem;border-radius:10px;
                margin-top:.5rem;font-size:.875rem;
                box-shadow:0 4px 12px rgba(0,0,0,.15);
                animation:fadeIn .2s ease;
            `;
            toast.textContent = message;
            document.getElementById('toastContainer').appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
