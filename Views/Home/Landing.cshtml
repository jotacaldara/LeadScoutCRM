                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-lg">Experimentar grátis <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="reveal">
                <div class="phone">
                    <div class="phone-head">
                        <span class="av"><i class="bi bi-shop"></i></span>
