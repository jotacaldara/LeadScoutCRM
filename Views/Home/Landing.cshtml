                        </div>
                        <div class="mock-col">
                            <div class="mock-col-head"><span class="d" style="background:var(--warm)"></span>Em Negociação</div>
                            <div class="mock-lead">
                                <div class="n">Clínica Vitalis</div>
                                <div class="m"><i class="bi bi-chat-dots"></i> respondeu hoje</div>
                                <span class="mock-badge badge-warm">Morno · 62</span>
                            </div>
                        </div>
                        <div class="mock-col">
                            <div class="mock-col-head"><span class="d" style="background:var(--hot)"></span>Fechado</div>
