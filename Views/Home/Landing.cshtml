    <!-- ══════════════════════════ FAQ ══════════════════════════ -->
    <section class="section">
        <div class="container">
            <div class="section-head reveal">
                <span class="eyebrow" style="margin-left:auto;margin-right:auto;">Perguntas frequentes</span>
                <h2>Ainda com dúvidas?</h2>
            </div>
            <div class="faq-list reveal">
                <div class="faq-item">
                    <button class="faq-q">Preciso de cartão de crédito para começar? <i class="bi bi-plus-lg"></i></button>
                    <div class="faq-a"><div class="faq-a-inner">Não. O plano Free é gratuito para sempre, até 10 leads.</div></div>
                </div>
                <div class="faq-item">
                    <button class="faq-q">De onde vêm os dados dos negócios? <i class="bi bi-plus-lg"></i></button>
                    <div class="faq-a"><div class="faq-a-inner">Do Google Places — a mesma base usada no Google Maps.</div></div>
                </div>
                <div class="faq-item">
                    <button class="faq-q">Posso cancelar quando quiser? <i class="bi bi-plus-lg"></i></button>
                    <div class="faq-a"><div class="faq-a-inner">Sim, a qualquer momento, nas definições da tua conta.</div></div>
                </div>
                <div class="faq-item">
                    <button class="faq-q">A IA substitui-me a escrever as mensagens? <i class="bi bi-plus-lg"></i></button>
                    <div class="faq-a"><div class="faq-a-inner">Não — dá-te um primeiro rascunho. A palavra final é sempre tua.</div></div>
                </div>
                <div class="faq-item">
                    <button class="faq-q">Os meus leads são privados? <i class="bi bi-plus-lg"></i></button>
                    <div class="faq-a"><div class="faq-a-inner">Sim. Cada conta vê apenas os seus próprios dados.</div></div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════ FINAL CTA ══════════════════════════ -->
    <section id="final-cta" class="section">
        <div class="container">
            <h2>Pronto para deixar o Excel para trás?</h2>
            <p>Cria a tua conta grátis e faz a primeira pesquisa em menos de 2 minutos.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">Criar conta grátis <i class="bi bi-arrow-right"></i></a>
        </div>
    </section>

    <!-- ══════════════════════════ FOOTER ══════════════════════════ -->
    <footer>
        <div class="container footer-inner">
            <a href="#hero" class="brand" style="font-size:1rem;">
                <span class="icon" style="width:28px;height:28px;font-size:.85rem;"><i class="bi bi-crosshair2"></i></span>
                LeadScout CRM
            </a>
            <div class="footer-links">
                <a href="#features">Funcionalidades</a>
                <a href="#pricing">Preços</a>
                <a asp-controller="Account" asp-action="Login">Entrar</a>
                <a asp-controller="Account" asp-action="Register">Criar conta</a>
            </div>
            <div class="footer-copy">© 2026 LeadScout CRM</div>
        </div>
    </footer>

    <script>
            // nav shadow on scroll
            const nav = document.getElementById('nav');
            window.addEventListener('scroll', () => {
              nav.classList.toggle('scrolled', window.scrollY > 8);
            });

            // scroll reveal
            const revealEls = document.querySelectorAll('.reveal');
            const io = new IntersectionObserver((entries) => {
              entries.forEach(e => {
                if (e.isIntersecting){
                  e.target.classList.add('in');
                  io.unobserve(e.target);
                }
              });
            }, {threshold:.15});
            revealEls.forEach(el => io.observe(el));

            // FAQ accordion
            document.querySelectorAll('.faq-q').forEach(btn => {
              btn.addEventListener('click', () => {
                const item = btn.closest('.faq-item');
                const wasOpen = item.classList.contains('open');
                document.querySelectorAll('.faq-item.open').forEach(o => o.classList.remove('open'));
                if (!wasOpen) item.classList.add('open');
              });
            });
    </script>

</body>
</html>
