                        <div class="mock-col">
                            <div class="mock-col-head"><span class="d" style="background:var(--cold)"></span>Novo</div>
                            <div class="mock-lead">
                                <div class="n">Clínica Sorriso Novo</div>
                                <div class="m"><i class="bi bi-telephone"></i> 21 xxx xx xx</div>
