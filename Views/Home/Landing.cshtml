@{
    ViewData["Title"] = "LeadScout CRM — Encontra. Organiza. Fecha.";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LeadScout CRM — Encontra. Organiza. Fecha.</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
            /* ────────────────────────────────────────────────────────────
               TOKENS
            ──────────────────────────────────────────────────────────── */
            :root{
              --ink:#14152b;
              --ink-soft:#40415c;
              --muted:#6b6d8a;
              --muted-2:#9496b3;
              --paper:#fcfbff;
              --paper-soft:#f4f3fb;
              --paper-dim:#eeedf9;
              --line:#e5e4f1;

              --brand:#6366f1;
              --brand-dark:#4f46e5;
              --brand-tint:#eef0ff;

              --cold:#3b82f6;
              --cold-tint:#eaf2ff;
              --warm:#f59e0b;
              --warm-tint:#fff6e3;
              --hot:#fb5b3d;
              --hot-tint:#ffefe9;

              --radius-lg:22px;
              --radius-md:14px;
              --radius-sm:9px;

              --shadow-1:0 1px 2px rgba(20,21,43,.05),0 2px 8px rgba(20,21,43,.05);
              --shadow-2:0 10px 30px rgba(20,21,43,.09),0 2px 8px rgba(20,21,43,.05);
              --shadow-brand:0 14px 30px rgba(99,102,241,.24);

              --font-display:'Space Grotesk',sans-serif;
              --font-body:'Inter',sans-serif;
              --font-mono:'IBM Plex Mono',monospace;
            }

            *{box-sizing:border-box;}
            html{scroll-behavior:smooth;}
            body{
              margin:0;
              font-family:var(--font-body);
              color:var(--ink-soft);
              background:var(--paper);
              -webkit-font-smoothing:antialiased;
              line-height:1.6;
            }
            h1,h2,h3,h4{
              font-family:var(--font-display);
              color:var(--ink);
              margin:0;
              line-height:1.15;
              letter-spacing:-.01em;
            }
            p{margin:0;}
            a{color:inherit;text-decoration:none;}
            img{max-width:100%;display:block;}
            button{font-family:inherit;cursor:pointer;}
            .mono{font-family:var(--font-mono);}

            @@media (prefers-reduced-motion: reduce){
              *{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important;scroll-behavior:auto !important;}
            }

            :focus-visible{outline:2px solid var(--brand);outline-offset:3px;border-radius:4px;}

            .container{
              max-width:1180px;
              margin:0 auto;
              padding:0 28px;
            }

            .section{padding:104px 0;}
            .section-tight{padding:72px 0;}

            @@media (max-width:860px){
              .section{padding:72px 0;}
              .section-tight{padding:52px 0;}
            }

            .eyebrow{
              display:inline-flex;
              align-items:center;
              gap:9px;
              font-family:var(--font-mono);
              font-size:.76rem;
              font-weight:600;
              letter-spacing:.06em;
              text-transform:uppercase;
              color:var(--brand);
              background:var(--brand-tint);
              padding:7px 14px 7px 10px;
              border-radius:100px;
              margin-bottom:22px;
            }
            .eyebrow .dots{display:flex;align-items:center;gap:4px;}
            .eyebrow .dot{width:6px;height:6px;border-radius:50%;}
            .eyebrow.on-dark{background:rgba(255,255,255,.08);color:#c7c9ff;}

            .section-head{max-width:640px;margin:0 auto 56px;text-align:center;}
            .section-head h2{font-size:2.15rem;margin-bottom:14px;}
            .section-head p{color:var(--muted);font-size:1.05rem;}
            @@media (max-width:640px){.section-head h2{font-size:1.7rem;}}

            .btn{
              display:inline-flex;
              align-items:center;
              justify-content:center;
              gap:8px;
              font-weight:600;
              font-size:.95rem;
              padding:13px 24px;
              border-radius:11px;
              border:1px solid transparent;
              transition:transform .15s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease;
              white-space:nowrap;
            }
            .btn:active{transform:translateY(1px);}
            .btn-brand{background:var(--brand);color:#fff;box-shadow:var(--shadow-brand);}
            .btn-brand:hover{background:var(--brand-dark);box-shadow:0 16px 34px rgba(99,102,241,.3);}
            .btn-ghost{background:transparent;border-color:var(--line);color:var(--ink);}
            .btn-ghost:hover{border-color:var(--muted-2);background:var(--paper-soft);}
            .btn-light{background:#fff;color:var(--ink);}
            .btn-light:hover{background:#f1f1fb;}
            .btn-outline-dark{background:transparent;border-color:rgba(255,255,255,.28);color:#fff;}
            .btn-outline-dark:hover{border-color:#fff;background:rgba(255,255,255,.06);}
            .btn-lg{padding:16px 30px;font-size:1rem;}
            .btn-sm{padding:9px 16px;font-size:.85rem;}
            .btn-block{width:100%;}

            /* ────────────────────────────────────────────────────────────
               NAV
            ──────────────────────────────────────────────────────────── */
            #nav{
              position:fixed;top:0;left:0;right:0;z-index:200;
              background:rgba(252,251,255,.78);
              backdrop-filter:blur(14px) saturate(160%);
              border-bottom:1px solid transparent;
              transition:border-color .2s ease, box-shadow .2s ease;
            }
            #nav.scrolled{border-bottom-color:var(--line);box-shadow:0 1px 0 rgba(20,21,43,.02);}
            .nav-inner{
              max-width:1180px;margin:0 auto;padding:16px 28px;
              display:flex;align-items:center;justify-content:space-between;gap:24px;
            }
            .brand{display:flex;align-items:center;gap:9px;font-family:var(--font-display);font-weight:700;font-size:1.12rem;color:var(--ink);}
            .brand .icon{
              width:34px;height:34px;border-radius:10px;background:var(--brand);color:#fff;
              display:flex;align-items:center;justify-content:center;font-size:1.05rem;flex-shrink:0;
            }
            .nav-links{display:flex;align-items:center;gap:32px;}
            .nav-links a{font-size:.9rem;font-weight:500;color:var(--ink-soft);transition:color .15s;}
            .nav-links a:hover{color:var(--brand);}
            .nav-actions{display:flex;align-items:center;gap:18px;}
            .nav-actions .signin{font-size:.9rem;font-weight:600;color:var(--ink-soft);}
            .nav-actions .signin:hover{color:var(--brand);}
            @@media (max-width:860px){
              .nav-links{display:none;}
            }

            /* ────────────────────────────────────────────────────────────
               HERO
            ──────────────────────────────────────────────────────────── */
            #hero{
              position:relative;
              padding:168px 0 100px;
              overflow:hidden;
              background:
                radial-gradient(560px 340px at 82% -6%, rgba(99,102,241,.14), transparent 65%),
                radial-gradient(420px 300px at 4% 18%, rgba(251,91,61,.08), transparent 60%);
            }
            .hero-grid{
              display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;
            }
            @@media (max-width:980px){
              .hero-grid{grid-template-columns:1fr;gap:56px;text-align:center;}
              .hero-copy .eyebrow{margin-left:auto;margin-right:auto;}
              .hero-cta-row{justify-content:center;}
            }
            .hero-copy h1{
              font-size:3.35rem;
              letter-spacing:-.02em;
              margin-bottom:22px;
            }
            @@media (max-width:980px){.hero-copy h1{font-size:2.5rem;}}
            @@media (max-width:480px){.hero-copy h1{font-size:2.05rem;}}
            .hero-copy .lead{font-size:1.14rem;color:var(--muted);max-width:520px;margin-bottom:34px;}
            @@media (max-width:980px){.hero-copy .lead{margin-left:auto;margin-right:auto;}}
            .hero-cta-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-bottom:16px;}
            .hero-micro{font-size:.83rem;color:var(--muted-2);display:flex;align-items:center;gap:7px;}
            .hero-micro i{color:var(--brand);}

            /* product mockup */
            .mock-wrap{position:relative;}
            .mock-card{
              background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);
              box-shadow:var(--shadow-2);
              padding:20px;
              transform:rotate(1.1deg);
            }
            .mock-topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
            .mock-topbar .title{font-family:var(--font-display);font-weight:600;font-size:.85rem;color:var(--ink);}
            .mock-topbar .sub{font-size:.72rem;color:var(--muted-2);}
            .mock-cols{display:grid;grid-template-columns:1fr 1fr 1fr;gap:11px;}
            .mock-col{background:var(--paper-soft);border-radius:12px;padding:10px;}
            .mock-col-head{display:flex;align-items:center;gap:6px;font-size:.68rem;font-weight:600;color:var(--ink-soft);margin-bottom:9px;padding:0 2px;}
            .mock-col-head .d{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
            .mock-lead{background:#fff;border:1px solid var(--line);border-radius:9px;padding:9px 10px;margin-bottom:7px;box-shadow:0 1px 2px rgba(20,21,43,.04);}
            .mock-lead .n{font-size:.71rem;font-weight:600;color:var(--ink);margin-bottom:5px;}
            .mock-lead .m{display:flex;align-items:center;gap:5px;font-size:.62rem;color:var(--muted-2);}
            .mock-badge{
              display:inline-flex;align-items:center;gap:4px;font-family:var(--font-mono);
              font-size:.6rem;font-weight:600;padding:2px 7px;border-radius:100px;margin-top:6px;
            }
            .badge-cold{background:var(--cold-tint);color:#1d4ed8;}
            .badge-warm{background:var(--warm-tint);color:#b45309;}
            .badge-hot{background:var(--hot-tint);color:#c2340f;}

            .float-score{
              position:absolute;top:-18px;right:-14px;
              background:var(--ink);color:#fff;
              border-radius:16px;padding:12px 16px;
              box-shadow:0 16px 30px rgba(20,21,43,.28);
              display:flex;align-items:center;gap:10px;
              transform:rotate(-3deg);
              animation:floatPulse 3.2s ease-in-out infinite;
            }
            .float-score .ic{width:30px;height:30px;border-radius:9px;background:var(--hot);display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0;}
            .float-score .txt .l{font-size:.62rem;color:#a9abd6;font-weight:600;letter-spacing:.03em;text-transform:uppercase;}
            .float-score .txt .v{font-family:var(--font-mono);font-size:1.05rem;font-weight:600;}

            .float-note{
              position:absolute;bottom:-16px;left:-18px;
              background:#fff;border:1px solid var(--line);
              border-radius:13px;padding:10px 14px;
              box-shadow:var(--shadow-2);
              display:flex;align-items:center;gap:9px;
              font-size:.74rem;font-weight:600;color:var(--ink-soft);
            }
            .float-note i{color:var(--brand);}

            @@keyframes floatPulse{
              0%,100%{transform:rotate(-3deg) translateY(0);}
              50%{transform:rotate(-3deg) translateY(-6px);}
            }

            @@media (max-width:980px){
              .mock-wrap{max-width:440px;margin:0 auto;}
              .float-score{right:6px;}
              .float-note{left:6px;}
            }
            @@media (max-width:520px){
              .mock-cols{grid-template-columns:1fr;}
              .float-score, .float-note{position:static;transform:none;margin-top:14px;width:fit-content;animation:none;}
              .float-score{margin-left:auto;margin-right:auto;}
              .float-note{margin-left:auto;margin-right:auto;}
            }

            /* ────────────────────────────────────────────────────────────
               REVEAL ON SCROLL
            ──────────────────────────────────────────────────────────── */
            .reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease, transform .6s ease;}
            .reveal.in{opacity:1;transform:translateY(0);}

            /* ────────────────────────────────────────────────────────────
               PROBLEM
            ──────────────────────────────────────────────────────────── */
            #problem{background:var(--paper-soft);}
            .problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
            @@media (max-width:860px){.problem-grid{grid-template-columns:1fr;}}
            .problem-card{
              background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);
              padding:28px 26px;
            }
            .problem-card .ic{
              width:44px;height:44px;border-radius:11px;background:var(--cold-tint);color:var(--cold);
              display:flex;align-items:center;justify-content:center;font-size:1.15rem;margin-bottom:18px;
            }
            .problem-card h3{font-size:1.08rem;margin-bottom:9px;}
            .problem-card p{color:var(--muted);font-size:.92rem;}

            .transition-line{
              display:flex;align-items:center;justify-content:center;gap:12px;
              margin-top:48px;color:var(--muted);font-size:.95rem;font-weight:500;
            }
            .transition-line i{color:var(--brand);}

            /* ────────────────────────────────────────────────────────────
               HOW IT WORKS
            ──────────────────────────────────────────────────────────── */
            .steps-track{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin-top:8px;}
            .steps-line{
              position:absolute;top:23px;left:calc(16.6% + 4px);right:calc(16.6% + 4px);height:3px;
              background:linear-gradient(90deg, var(--cold), var(--warm) 50%, var(--hot));
              border-radius:3px;opacity:.35;
            }
            @@media (max-width:860px){
              .steps-track{grid-template-columns:1fr;gap:40px;}
              .steps-line{display:none;}
            }
            .step{position:relative;text-align:left;}
            .step-num{
              width:46px;height:46px;border-radius:50%;
              display:flex;align-items:center;justify-content:center;
              font-family:var(--font-mono);font-weight:600;font-size:1rem;color:#fff;
              margin-bottom:20px;position:relative;z-index:2;
              box-shadow:0 8px 18px rgba(20,21,43,.14);
            }
            .step:nth-child(1) .step-num{background:var(--cold);}
            .step:nth-child(2) .step-num{background:var(--warm);}
            .step:nth-child(3) .step-num{background:var(--hot);}
            .step h3{font-size:1.15rem;margin-bottom:10px;display:flex;align-items:center;gap:9px;}
            .step h3 i{font-size:1rem;color:var(--muted-2);}
            .step p{color:var(--muted);font-size:.94rem;}

            /* ────────────────────────────────────────────────────────────
               FEATURES
            ──────────────────────────────────────────────────────────── */
            #features{background:var(--paper-soft);}
            .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
            @@media (max-width:900px){.feat-grid{grid-template-columns:1fr 1fr;}}
            @@media (max-width:600px){.feat-grid{grid-template-columns:1fr;}}
            .feat-card{
              background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);
              padding:26px;transition:box-shadow .18s ease, transform .18s ease, border-color .18s ease;
            }
            .feat-card:hover{box-shadow:var(--shadow-2);transform:translateY(-3px);border-color:#dcdbee;}
            .feat-card .ic{
              width:40px;height:40px;border-radius:10px;background:var(--brand-tint);color:var(--brand);
              display:flex;align-items:center;justify-content:center;font-size:1.05rem;margin-bottom:16px;
            }
            .feat-card h3{font-size:1.02rem;margin-bottom:8px;}
            .feat-card p{color:var(--muted);font-size:.88rem;}
            .feat-card .mini-badge{
              display:inline-flex;align-items:center;gap:5px;margin-top:12px;
              font-family:var(--font-mono);font-size:.68rem;font-weight:600;
              background:var(--hot-tint);color:#c2340f;padding:3px 9px;border-radius:100px;
            }

            /* ────────────────────────────────────────────────────────────
               AI SECTION (dark)
            ──────────────────────────────────────────────────────────── */
            #ai-highlight{
              background:var(--ink);color:#fff;position:relative;overflow:hidden;
            }
            #ai-highlight::before{
              content:'';position:absolute;inset:0;
              background:radial-gradient(600px 400px at 90% 20%, rgba(99,102,241,.22), transparent 60%);
              pointer-events:none;
            }
            .ai-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;position:relative;z-index:1;}
            @@media (max-width:940px){.ai-grid{grid-template-columns:1fr;gap:48px;}}
            .ai-copy h2{color:#fff;font-size:2.05rem;margin-bottom:18px;}
            @@media (max-width:640px){.ai-copy h2{font-size:1.65rem;}}
            .ai-copy p{color:#c3c4de;font-size:1.02rem;margin-bottom:28px;max-width:480px;}

            .phone{
              background:#0c0d1e;border-radius:28px;padding:16px;
              box-shadow:0 30px 60px rgba(0,0,0,.4);
              max-width:340px;margin:0 auto;
              border:1px solid rgba(255,255,255,.08);
            }
            .phone-head{display:flex;align-items:center;gap:10px;padding:6px 8px 14px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:14px;}
            .phone-head .av{width:34px;height:34px;border-radius:50%;background:var(--brand);display:flex;align-items:center;justify-content:center;font-size:.9rem;color:#fff;flex-shrink:0;}
            .phone-head .nm{font-size:.85rem;font-weight:600;color:#fff;}
            .phone-head .st{font-size:.68rem;color:#8f91b8;}
            .bubble{
              background:#dcf8c6;color:#1a2e1a;border-radius:14px 14px 14px 3px;
              padding:12px 14px;font-size:.82rem;line-height:1.55;margin-bottom:8px;
              box-shadow:0 3px 10px rgba(0,0,0,.15);
            }
            .bubble .cursor{display:inline-block;width:6px;height:14px;background:#1a2e1a;opacity:.5;vertical-align:middle;animation:blink 1s step-end infinite;}
            @@keyframes blink{50%{opacity:0;}}
            .bubble-time{font-size:.62rem;color:#7c9a7c;text-align:right;margin-top:4px;}
            .phone-typing{display:flex;align-items:center;gap:6px;color:#8f91b8;font-size:.72rem;margin-top:10px;}
            .phone-typing .dots span{display:inline-block;width:4px;height:4px;border-radius:50%;background:#8f91b8;margin-right:3px;animation:typingDot 1.2s infinite;}
            .phone-typing .dots span:nth-child(2){animation-delay:.2s;}
            .phone-typing .dots span:nth-child(3){animation-delay:.4s;}
            @@keyframes typingDot{0%,60%,100%{opacity:.25;}30%{opacity:1;}}

            /* ────────────────────────────────────────────────────────────
               TRUST
            ──────────────────────────────────────────────────────────── */
            .trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;}
            @@media (max-width:800px){.trust-grid{grid-template-columns:1fr;gap:28px;}}
            .trust-item{display:flex;gap:16px;align-items:flex-start;}
            .trust-item .ic{
              width:42px;height:42px;border-radius:11px;background:var(--brand-tint);color:var(--brand);
              display:flex;align-items:center;justify-content:center;font-size:1.05rem;flex-shrink:0;
            }
            .trust-item h3{font-size:1rem;margin-bottom:6px;}
            .trust-item p{font-size:.87rem;color:var(--muted);}

            /* ────────────────────────────────────────────────────────────
               PRICING
            ──────────────────────────────────────────────────────────── */
            #pricing{background:var(--paper-soft);}
            .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch;}
            @@media (max-width:900px){.price-grid{grid-template-columns:1fr;max-width:420px;margin:0 auto;}}
            .price-card{
              background:#fff;border:1.5px solid var(--line);border-radius:var(--radius-lg);
              padding:32px 28px;display:flex;flex-direction:column;position:relative;
            }
            .price-card.featured{
              border-color:var(--brand);box-shadow:0 20px 44px rgba(99,102,241,.18);
              transform:translateY(-8px);
            }
            .price-tag{
              position:absolute;top:-13px;left:50%;transform:translateX(-50%);
              background:var(--brand);color:#fff;font-size:.7rem;font-weight:600;
              padding:5px 14px;border-radius:100px;letter-spacing:.02em;
            }
            .price-card .pname{font-family:var(--font-display);font-weight:600;font-size:1.05rem;color:var(--ink);margin-bottom:14px;}
            .price-card .pcost{display:flex;align-items:baseline;gap:6px;margin-bottom:22px;}
            .price-card .pcost .v{font-family:var(--font-display);font-size:2.5rem;font-weight:700;color:var(--ink);}
            .price-card .pcost .u{color:var(--muted);font-size:.85rem;}
            .price-feats{list-style:none;padding:0;margin:0 0 26px;flex:1;}
            .price-feats li{display:flex;align-items:flex-start;gap:9px;font-size:.87rem;color:var(--ink-soft);margin-bottom:11px;}
            .price-feats li i{color:var(--brand);font-size:.9rem;margin-top:2px;flex-shrink:0;}
            .price-feats li.muted{color:var(--muted-2);}
            .price-feats li.muted i{color:var(--muted-2);}

            /* ────────────────────────────────────────────────────────────
               FAQ
            ──────────────────────────────────────────────────────────── */
            .faq-list{max-width:720px;margin:0 auto;}
            .faq-item{border-bottom:1px solid var(--line);}
            .faq-q{
              width:100%;background:none;border:none;text-align:left;
              padding:22px 4px;display:flex;align-items:center;justify-content:space-between;gap:16px;
              font-family:var(--font-display);font-weight:600;font-size:1rem;color:var(--ink);
            }
            .faq-q i{color:var(--brand);transition:transform .25s ease;flex-shrink:0;}
            .faq-item.open .faq-q i{transform:rotate(45deg);}
            .faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
            .faq-a-inner{padding:0 4px 22px;color:var(--muted);font-size:.92rem;max-width:600px;}
            .faq-item.open .faq-a{max-height:220px;}

            /* ────────────────────────────────────────────────────────────
               FINAL CTA
            ──────────────────────────────────────────────────────────── */
            #final-cta{
              background:linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
              text-align:center;position:relative;overflow:hidden;
            }
            #final-cta::before{
              content:'';position:absolute;inset:0;
              background:radial-gradient(500px 300px at 15% 100%, rgba(251,91,61,.25), transparent 60%);
            }
