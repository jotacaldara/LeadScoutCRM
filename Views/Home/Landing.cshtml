            @@media (max-width:640px){#final-cta h2{font-size:1.75rem;}}
            #final-cta p{color:#e2e2ff;font-size:1.05rem;margin-bottom:32px;}

            /* ────────────────────────────────────────────────────────────
               FOOTER
            ──────────────────────────────────────────────────────────── */
            footer{padding:44px 0;border-top:1px solid var(--line);}
            .footer-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;}
            .footer-links{display:flex;gap:26px;flex-wrap:wrap;}
            .footer-links a{font-size:.85rem;color:var(--muted);}
            .footer-links a:hover{color:var(--brand);}
            .footer-copy{font-size:.8rem;color:var(--muted-2);}
    </style>
</head>
<body>

    <!-- ══════════════════════════ NAV ══════════════════════════ -->
