@using LeadScoutCRM.Services
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Dashboard</h4>
        <span class="text-muted" style="font-size:.875rem">Bem-vindo ao LeadScout CRM</span>
    </div>
    <a href="/Leads/Search" class="btn btn-accent px-4">
        <i class="bi bi-plus-lg me-1"></i> Nova Pesquisa
    </a>
</div>

<!-- ── Stat Cards ── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box" style="background:#ede9fe">
                    <i class="bi bi-people-fill" style="color:#6366f1"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:.75rem">Total de Leads</div>
                    <div class="fw-bold fs-4">@ViewBag.TotalLeads</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box" style="background:#dcfce7">
                    <i class="bi bi-trophy-fill" style="color:#15803d"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:.75rem">Clientes Fechados</div>
                    <div class="fw-bold fs-4">@ViewBag.LeadsFechadas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box" style="background:#fef9c3">
                    <i class="bi bi-chat-dots-fill" style="color:#a16207"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:.75rem">Em Negociação</div>
                    <div class="fw-bold fs-4">@ViewBag.EmNegociacao</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box" style="background:#dbeafe">
                    <i class="bi bi-lightning-fill" style="color:#1d4ed8"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:.75rem">Novas (hoje)</div>
                    <div class="fw-bold fs-4">@ViewBag.LeadsHoje</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Leads Recentes ── -->
<div class="card table-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <span class="fw-semibold">Leads Recentes</span>
        <a href="/Leads" class="btn btn-sm btn-outline-secondary">Ver todas</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Empresa</th>
                    <th>Nicho</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>Data</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lead in ViewBag.RecentLeads as List<LeadScoutCRM.Models.Entities.Lead> ?? new())
                {
                    <tr>
                        <td class="fw-medium">@lead.BusinessName</td>
                        <td><span class="badge bg-light text-dark">@lead.Niche</span></td>
                        <td>@Html.Partial("_StatusBadge", lead.Status)</td>
                        @{
                            var score = LeadScoutCRM.Services.LeadScoringService.CalculateScore(lead);
                            var (label, css) = LeadScoutCRM.Services.LeadScoringService.GetScoreBadge(score);
                        }
                        <td>
                            <span class="badge rounded-pill px-2 py-1" style="font-size:.7rem;@css">
                                @label · @score
                            </span>
                        </td>
                        <td class="text-muted" style="font-size:.85rem">
                            @lead.CreatedAt.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <a href="/Leads/Detail/@lead.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>